# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env.local 은 .gitignore 에 있으므로 커밋되지 않습니다.

# ── Supabase ──────────────────────────────────────────────
# 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ 여기에 NEXT_PUBLIC_ 을 절대 붙이지 마세요.
#    붙이면 이 키가 브라우저 번들에 포함되어 DB 전체가 공개됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── GA4 ───────────────────────────────────────────────────
# 값이 없으면 추적 스크립트를 넣지 않습니다 (앱은 정상 동작).
NEXT_PUBLIC_GA_ID=

# ── Claude API ────────────────────────────────────────────
# 값이 없으면 메시지 카드는 사전 작성 문구로만 나갑니다.
ANTHROPIC_API_KEY=
